# Copy to .env.local and fill in. Every value is optional in development.
# NEXT_PUBLIC_* values are embedded in the browser bundle — never put secrets here.

# Google Form used by every "Join the Program" button.
# Optional override: defaults to the official CommitClubHQ sign-up form.
NEXT_PUBLIC_PROGRAM_FORM_URL=

# Production origin, e.g. https://example.com (no trailing slash).
# Enables canonical URL and absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=

# Social profiles. Optional overrides: the footer defaults to the official CommitClubHQ profiles.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional page for the "Break the Loop" book. Falls back to the Join section.
NEXT_PUBLIC_BOOK_URL=
